{
  "name": "react-electron-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on -t 300000 -i 5000 http-get://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "react-start": "webpack serve --config webpack.config.js",
    "build": "webpack --config webpack.config.js --mode production",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "build": {
    "appId": "com.electron.app",
    "win": {
      "icon": "build/EAGLE.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A simple React Electron desktop application",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@react-google-maps/api": "^2.20.6",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.1",
    "d3": "^7.9.0",
    "electron-builder": "^26.8.1",
    "follow-redirects": "^1.16.0",
    "framer-motion": "^11.0.0",
    "hls.js": "^1.6.16",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.15.3",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.6",
    "video.js": "^8.21.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "electron": "^41.2.0",
    "electron-is-dev": "^3.0.1",
    "file-loader": "^6.0.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "path-browserify": "^1.0.1",
    "style-loader": "^3.3.4",
    "url-loader": "^4.1.1",
