  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "brace-expansion": ">=5.0.8",
    "minimatch": ">=10.2.5",
    "glob": ">=11.0.0",
    "uuid": ">=11.1.1",
    "shell-quote": ">=1.8.3"
  }
}
